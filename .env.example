# IPMPRS System Environment Configuration (Template)
# Copy to .env in backend/ or root for development

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Provide local or MongoDB Atlas URI; if empty or unreachable in dev mode,
# backend automatically initiates embedded in-memory MongoDB for zero-friction setup.
MONGODB_URI=mongodb://127.0.0.1:27017/ipmprs

# JWT Secret for Session Authentication
JWT_SECRET=ipmprs_secure_jwt_dev_secret_key_change_in_production_2026
JWT_EXPIRES_IN=8h

# File Storage Configuration
STORAGE_DIR=./storage/documents
MAX_FILE_SIZE_MB=25

# AI Service Configuration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=15000

# LLM Provider Configuration (mock, gemini, groq, ollama)
# If no key is configured, fallback mock mode grounds RAG report in actual FAISS chunks with explicit status.
LLM_PROVIDER=mock
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Logging & Auditing
LOG_LEVEL=info
